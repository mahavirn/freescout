{
    "name": "freescout-helpdesk/freescout",
    "description": "Free self-hosted helpdesk and shared mailbox (Zendesk / Help Scout alternative)",
    "keywords": [
        "helpdesk",
        "help desk",
        "shared mailbox"
    ],
    "license": "AGPL-3.0",
    "authors": [
        {
            "name": "The FreeScout Team",
            "email": "support@freescout.net"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/freescout-help-desk/Purifier"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-zip": "*",
        "barryvdh/laravel-translation-manager": "^0.6.9",
        "egulias/email-validator": "^4.0",
        "enshrined/svg-sanitize": "^0.22",
        "guzzlehttp/guzzle": "^7.9",
        "html2text/html2text": "^4.3",
        "javoscript/laravel-macroable-models": "^1.0.7",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "mews/purifier": "dev-customized",
        "nwidart/laravel-modules": "2.7.0",
        "rap2hpoutre/laravel-log-viewer": "^3.1",
        "spatie/laravel-activitylog": "^4.12",
        "tedivm/jshrink": "^1.7",
        "tormjens/eventy": "^0.9.5",
        "watson/rememberable": "^7.1",
        "webklex/php-imap": "4.1.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "overrides/natxet/cssmin/src/",
            "overrides/compat/"
        ],
        "files": [
            "app/Misc/LegacyHelpers.php",
            "app/Misc/Functions.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Modules\\": "Modules/",
            "Webklex\\PHPIMAP\\": "overrides/webklex/php-imap/src/",
            "Nwidart\\Modules\\": "overrides/nwidart/laravel-modules/src/",
            "Nwidart\\Modules\\Generators\\": "overrides/nwidart/laravel-modules/src/Generators/",
            "Barryvdh\\TranslationManager\\": "overrides/barryvdh/laravel-translation-manager/src/",
            "TorMorten\\Eventy\\": "overrides/tormjens/eventy/src/",
            "Rap2hpoutre\\LaravelLogViewer\\": "overrides/rap2hpoutre/laravel-log-viewer/src/Rap2hpoutre/LaravelLogViewer/",
            "Lord\\Laroute\\": "overrides/lord/laroute/src/",
            "Axn\\Laroute\\": "overrides/axn/laravel-laroute/src/",
            "Devfactory\\Minify\\": "overrides/devfactory/minify/src/",
            "Codedge\\Updater\\": "overrides/codedge/laravel-selfupdater/src/"
        },
        "exclude-from-classmap": [
            "Modules/",
            "vendor/barryvdh/laravel-translation-manager/src/Controller.php",
            "vendor/barryvdh/laravel-translation-manager/src/Manager.php",
            "vendor/nwidart/laravel-modules/src/Commands/FactoryMakeCommand.php",
            "vendor/nwidart/laravel-modules/src/Commands/MigrationMakeCommand.php",
            "vendor/nwidart/laravel-modules/src/Generators/ModuleGenerator.php",
            "vendor/nwidart/laravel-modules/src/Json.php",
            "vendor/nwidart/laravel-modules/src/Module.php",
            "vendor/nwidart/laravel-modules/src/Process/Installer.php",
            "vendor/nwidart/laravel-modules/src/Repository.php",
            "vendor/rap2hpoutre/laravel-log-viewer/src/Rap2hpoutre/LaravelLogViewer/LaravelLogViewer.php",
            "vendor/rap2hpoutre/laravel-log-viewer/src/controllers/LogViewerController.php",
            "vendor/tormjens/eventy/src/Event.php",
            "vendor/webklex/php-imap/src/Attachment.php",
            "vendor/webklex/php-imap/src/Client.php",
            "vendor/webklex/php-imap/src/ClientManager.php",
            "vendor/webklex/php-imap/src/Connection/Protocols/ImapProtocol.php",
            "vendor/webklex/php-imap/src/Connection/Protocols/LegacyProtocol.php",
            "vendor/webklex/php-imap/src/Connection/Protocols/PopProtocol.php",
            "vendor/webklex/php-imap/src/EncodingAliases.php",
            "vendor/webklex/php-imap/src/Folder.php",
            "vendor/webklex/php-imap/src/Header.php",
            "vendor/webklex/php-imap/src/Message.php",
            "vendor/webklex/php-imap/src/Part.php",
            "vendor/webklex/php-imap/src/Query/Query.php",
            "vendor/webklex/php-imap/src/Query/WhereQuery.php",
            "vendor/webklex/php-imap/src/Structure.php",
            "vendor/webklex/php-imap/src/config/imap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "audit": {
            "ignore": {
                "PKSA-nhqw-xk85-x2jn": "Fixed in overrides/webklex/php-imap/src/Attachment.php (filename sanitized in save() and setName())."
            }
        }
    }
}
